{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SIAPP-Pocos/Comunidade/esquema/contribuicao-v1.schema.json",
  "title": "Contribuição SIAPP — versão 1 (rascunho)",
  "description": "Pacote de correções e dados tratados do acervo público REATE (ANP/CPRM), gerado pelo SIAPP. Nunca contém os arquivos originais do portal: os documentos são identificados pelo caminho no REATE e pelo hash SHA-256 do conteúdo.",
  "type": "object",
  "required": ["formato", "versao_formato", "id", "criado_em", "autor", "licenca"],
  "additionalProperties": false,
  "properties": {
    "formato": { "const": "siapp-contribuicao" },
    "versao_formato": { "const": 1 },
    "id": { "type": "string", "format": "uuid", "description": "Identificador único do pacote." },
    "criado_em": { "type": "string", "format": "date-time" },
    "siapp_versao": { "type": "string" },
    "licenca": { "const": "CC-BY-4.0", "description": "Ao contribuir, o autor licencia o conteúdo sob CC-BY 4.0." },
    "autor": {
      "type": "object",
      "required": ["nome"],
      "additionalProperties": false,
      "properties": {
        "nome": { "type": "string", "minLength": 2 },
        "instituicao": { "type": "string" },
        "orcid": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" }
      }
    },
    "vocabulario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palavras": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
        "correcoes": {
          "type": "array",
          "description": "Formas lidas errado pelo OCR e a forma correta. Nunca números isolados.",
          "items": {
            "type": "object",
            "required": ["de", "para"],
            "additionalProperties": false,
            "properties": {
              "de": { "type": "string", "minLength": 3, "pattern": "[A-Za-zÀ-ÿ]" },
              "para": { "type": "string", "minLength": 1 }
            }
          }
        },
        "manter_original": {
          "type": "array",
          "description": "Palavras que a correção automática NÃO deve alterar.",
          "items": { "type": "string" }, "uniqueItems": true
        }
      }
    },
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bacia", "poco", "caminho_remoto", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "bacia": { "type": "string" },
          "poco": { "type": "string" },
          "caminho_remoto": { "type": "string", "pattern": "^/", "description": "Caminho do arquivo no compartilhamento da bacia no REATE." },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "texto": {
            "type": "object",
            "description": "Texto extraído (OCR ou embutido), para quem importar não precisar processar.",
            "required": ["arquivo", "metodo", "n_paginas"],
            "additionalProperties": false,
            "properties": {
              "arquivo": { "type": "string", "pattern": "^textos/[0-9a-f]{64}\\.json\\.gz$" },
              "metodo": { "enum": ["embutido", "ocr", "misto"] },
              "idioma": { "type": "string" },
              "versao_extracao": { "type": "integer" },
              "n_paginas": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
